# Server port (must be 3000 in AI Studio preview)
PORT=3000

# Secret used to sign JWT authentication tokens
JWT_SECRET="replace-with-strong-random-secret"

# Optional SQLite database file path (defaults to ./data/local-service-finder.sqlite)
SQLITE_DB_PATH="./data/local-service-finder.sqlite"

# Optional application base URL
APP_URL="http://localhost:3000"
